<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nerdfolio Tool Center"
    Height="750"
    Width="1100"
    MinHeight="600"
    MinWidth="900"
    WindowStartupLocation="CenterScreen"
    Background="#1E1E2E"
    FontFamily="Segoe UI"
    FontSize="13"
    ResizeMode="CanResize">

    <Window.Resources>

        <!-- Color Palette -->
        <SolidColorBrush x:Key="BgPrimary"       Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgSurface"       Color="#2A2A3E"/>
        <SolidColorBrush x:Key="BgBorder"        Color="#3A3A5C"/>
        <SolidColorBrush x:Key="AccentTeal"      Color="#00D4AA"/>
        <SolidColorBrush x:Key="AccentTealHover" Color="#00B894"/>
        <SolidColorBrush x:Key="AccentBlue"      Color="#0984E3"/>
        <SolidColorBrush x:Key="TextPrimary"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary"   Color="#A0A0C0"/>
        <SolidColorBrush x:Key="StatusOnline"    Color="#00D4AA"/>
        <SolidColorBrush x:Key="StatusOffline"   Color="#E17055"/>
        <SolidColorBrush x:Key="ColorSuccess"    Color="#00B894"/>
        <SolidColorBrush x:Key="ColorWarning"    Color="#FDCB6E"/>
        <SolidColorBrush x:Key="ColorError"      Color="#E17055"/>

        <!-- Nav Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"       Value="48"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"      Value="20,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="16,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"   Value="#2A2A3E"/>
                                <Setter TargetName="Border" Property="BorderBrush"  Value="#3A3A5C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Border" Property="Background"  Value="#2A2A3E"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentTeal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background"  Value="#3A3A5C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentTeal}"/>
                                <Setter Property="Foreground" Value="#1E1E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Button Style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background"  Value="{StaticResource AccentTeal}"/>
            <Setter Property="Foreground"  Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource BgSurface}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BgBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"      Value="{StaticResource AccentTeal}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Label Style -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="32"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- HEADER                                          -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BgBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Title -->
                    <ColumnDefinition Width="*"/>     <!-- Spacer -->
                    <ColumnDefinition Width="400"/>   <!-- PC Selector -->
                    <ColumnDefinition Width="Auto"/>  <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center">
                    <TextBlock Text="TOOL CENTER"
                               Foreground="{StaticResource AccentTeal}"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Nerdfolio Helpdesk Suite"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"/>
                </StackPanel>

                <!-- PC Selector -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>   <!-- Status dot -->
                        <ColumnDefinition Width="90"/>   <!-- Search button -->
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtComputerName"
                             Grid.Column="0"
                             Style="{StaticResource ModernTextBox}"
                             Text=""
                             ToolTip="Type a computer name or click Search to query AD"/>

                    <!-- Connection status dot -->
                    <Ellipse x:Name="StatusDot"
                             Grid.Column="1"
                             Width="12" Height="12"
                             Fill="{StaticResource StatusOffline}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             ToolTip="Offline"/>

                    <Button x:Name="BtnSearchAD"
                            Grid.Column="2"
                            Content="Search AD"
                            Style="{StaticResource ActionButton}"
                            Margin="8,0,0,0"
                            FontSize="12"/>
                </Grid>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- CONTENT                                         -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>   <!-- Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Main panel -->
                <ColumnDefinition Width="260"/>   <!-- Info panel -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BgBorder}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,16,0,0">

                    <TextBlock Text="NAVIGATION"
                               Style="{StaticResource SectionLabel}"
                               Foreground="{StaticResource AccentTeal}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="20,0,0,12"
                               Opacity="0.8"/>

                    <Button x:Name="NavAD"
                            Content="Active Directory"
                            Style="{StaticResource NavButton}"
                            Tag="Active"/>

                    <Button x:Name="NavTools"
                            Content="Tools"
                            Style="{StaticResource NavButton}"/>

                    <Button x:Name="NavFavorites"
                            Content="Favorites"
                            Style="{StaticResource NavButton}"/>

                    <Button x:Name="NavWeb"
                            Content="Web Links"
                            Style="{StaticResource NavButton}"/>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{StaticResource BgBorder}"
                            Margin="20,16"/>

                    <TextBlock Text="SYSTEM"
                               Style="{StaticResource SectionLabel}"
                               Foreground="{StaticResource AccentTeal}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="20,0,0,12"
                               Opacity="0.8"/>

                    <Button x:Name="NavSettings"
                            Content="Settings"
                            Style="{StaticResource NavButton}"/>

                </StackPanel>
            </Border>

            <!-- MAIN PANEL -->
            <Border Grid.Column="1"
                    Background="{StaticResource BgPrimary}"
                    Padding="24">

                <!-- Content Frame - panels swap here -->
                <Grid x:Name="MainContent">

                    <!-- AD PANEL -->
                    <StackPanel x:Name="PanelAD" Visibility="Visible">
                        <TextBlock Text="Active Directory"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="ACCOUNT MANAGEMENT"
                                   Style="{StaticResource SectionLabel}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <Button x:Name="BtnADUnlock"
                                    Content="Unlock Account"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnPWReset"
                                    Content="Password Reset"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                            <Button x:Name="BtnLogonHours"
                                    Content="VPN Logon Hours"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnADSearch"
                                    Content="Find Computer"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                        </UniformGrid>

                        <TextBlock Text="REMOTE MANAGEMENT"
                                   Style="{StaticResource SectionLabel}"/>

                        <UniformGrid Columns="2">
                            <Button x:Name="BtnRemoteAssist"
                                    Content="Remote Assistance"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnRemoteDesktop"
                                    Content="Remote Desktop"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                            <Button x:Name="BtnEnableWinRM"
                                    Content="Enable WinRM"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnRestartPC"
                                    Content="Restart PC"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- TOOLS PANEL -->
                    <StackPanel x:Name="PanelTools" Visibility="Collapsed">
                        <TextBlock Text="Tools"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="SYSTEM TOOLS"
                                   Style="{StaticResource SectionLabel}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <Button x:Name="BtnPCInfo"
                                    Content="PC Info"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnPrintQueue"
                                    Content="Reset Print Queue"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                            <Button x:Name="BtnCompMgmt"
                                    Content="Computer Management"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnRegedit"
                                    Content="Registry Editor"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                            <Button x:Name="BtnADUC"
                                    Content="ADUC"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnADAC"
                                    Content="ADAC"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                        </UniformGrid>

                        <TextBlock Text="COMPLIANCE"
                                   Style="{StaticResource SectionLabel}"/>

                        <UniformGrid Columns="2">
                            <Button x:Name="BtnCrowdStrike"
                                    Content="CrowdStrike Status"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnBigFix"
                                    Content="BigFix Status"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                            <Button x:Name="BtnTPM"
                                    Content="TPM Status"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnDotNet"
                                    Content=".NET Version"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                        </UniformGrid>
                    </StackPanel>

                    <!-- FAVORITES PANEL -->
                    <StackPanel x:Name="PanelFavorites" Visibility="Collapsed">
                        <TextBlock Text="Favorites"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="QUICK LAUNCH"
                                   Style="{StaticResource SectionLabel}"/>

                        <TextBlock Text="Configure favorites in favorites.json"
                                      Foreground="{StaticResource TextSecondary}"
                                      FontSize="12"
                                      Margin="0,0,0,16"/>

                        <WrapPanel x:Name="FavoritesPanel"
                                   Orientation="Horizontal"/>
                    </StackPanel>

                    <!-- WEB LINKS PANEL -->
                    <StackPanel x:Name="PanelWeb" Visibility="Collapsed">
                        <TextBlock Text="Web Links"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="HELPDESK PORTALS"
                                   Style="{StaticResource SectionLabel}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,24">
                            <Button x:Name="BtnTickets"
                                    Content="Ticket System"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnAdobeAdmin"
                                    Content="Adobe Admin"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                            <Button x:Name="BtnAirwatch"
                                    Content="Airwatch MDM"
                                    Style="{StaticResource ActionButton}"
                                    Margin="0,0,8,8"/>
                            <Button x:Name="BtnERPM"
                                    Content="ERPM"
                                    Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,8"/>
                            </UniformGrid>
                        </StackPanel>

                    <!-- SETTINGS PANEL -->
                    <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                        <TextBlock Text="Settings"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,24"/>

                        <TextBlock Text="VOICE &amp; NOTIFICATIONS"
                                   Style="{StaticResource SectionLabel}"/>

                        <StackPanel Margin="0,0,0,16">
                            <CheckBox x:Name="ChkTTS"
                                      Content="Enable Text-to-Speech"
                                      Foreground="{StaticResource TextPrimary}"
                                      IsChecked="True"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkBalloon"
                                      Content="Enable Balloon Notifications"
                                      Foreground="{StaticResource TextPrimary}"
                                      IsChecked="True"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkStartupSound"
                                      Content="Play sound on startup"
                                      Foreground="{StaticResource TextPrimary}"
                                      IsChecked="True"/>
                        </StackPanel>

                        <TextBlock Text="AD CONNECTION"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,16,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Search Base:"
                                       Foreground="{StaticResource TextSecondary}"
                                       Width="100"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSearchBase"
                                     Style="{StaticResource ModernTextBox}"
                                     Width="300"
                                     Text="DC=domain,DC=com"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="AD Filter:"
                                       Foreground="{StaticResource TextSecondary}"
                                       Width="100"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtADFilter"
                                     Style="{StaticResource ModernTextBox}"
                                     Width="300"
                                     Text="*"/>
                        </StackPanel>

                        <Button x:Name="BtnSaveSettings"
                                Content="Save Settings"
                                Style="{StaticResource AccentButton}"
                                Width="150"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- INFO PANEL (right sidebar) -->
            <Border Grid.Column="2"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BgBorder}"
                    BorderThickness="1,0,0,0"
                    Padding="16">
                <StackPanel>

                    <TextBlock Text="COMPUTER INFO"
                               Style="{StaticResource SectionLabel}"/>

                    <!-- Status indicator -->
                    <Border Background="{StaticResource BgPrimary}"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse x:Name="InfoStatusDot"
                                         Width="10" Height="10"
                                         Fill="{StaticResource StatusOffline}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatusLabel"
                                           Text="No computer selected"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PC Info fields -->
                    <Grid x:Name="PCInfoGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row helper macro - repeated for each field -->
                        <!-- Model -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Model"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <TextBlock x:Name="InfoModel"
                                   Grid.Row="0" Grid.Column="1"
                                   Text="N/A"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="11" Margin="0,0,0,12"
                                   HorizontalAlignment="Right"/>

                        <!-- User -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Logged In"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <TextBlock x:Name="InfoUser"
                                   Grid.Row="1" Grid.Column="1"
                                   Text="N/A"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="11" Margin="0,0,0,12"
                                   HorizontalAlignment="Right"/>

                        <!-- OS -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="OS"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <TextBlock x:Name="InfoOS"
                                   Grid.Row="2" Grid.Column="1"
                                   Text="N/A"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="11" Margin="0,0,0,12"
                                   HorizontalAlignment="Right"
                                   TextWrapping="Wrap"
                                   MaxWidth="140"/>

                        <!-- IP -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="IP Address"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="3" Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBlock x:Name="InfoIP"
                                       Text="N/A"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnCopyIP"
                                    Content="copy"
                                    Width="32" Height="20"
                                    FontSize="9"
                                    Background="Transparent"
                                    Foreground="{StaticResource AccentTeal}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0"
                                    ToolTip="Copy IP"/>
                        </StackPanel>

                        <!-- MAC -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="MAC"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="4" Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBlock x:Name="InfoMAC"
                                       Text="N/A"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnCopyMAC"
                                    Content="copy"
                                    Width="32" Height="20"
                                    FontSize="9"
                                    Background="Transparent"
                                    Foreground="{StaticResource AccentTeal}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0"
                                    ToolTip="Copy MAC"/>
                        </StackPanel>

                        <!-- Serial -->
                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Serial"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="5" Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,12">
                            <TextBlock x:Name="InfoSerial"
                                       Text="N/A"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnCopySerial"
                                    Content="copy"
                                    Width="32" Height="20"
                                    FontSize="9"
                                    Background="Transparent"
                                    Foreground="{StaticResource AccentTeal}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0"
                                    ToolTip="Copy Serial"/>
                        </StackPanel>

                        <!-- Uptime -->
                        <TextBlock Grid.Row="6" Grid.Column="0"
                                   Text="Uptime"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <TextBlock x:Name="InfoUptime"
                                   Grid.Row="6" Grid.Column="1"
                                   Text="N/A"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="11" Margin="0,0,0,12"
                                   HorizontalAlignment="Right"/>

                        <!-- TPM -->
                        <TextBlock Grid.Row="7" Grid.Column="0"
                                   Text="TPM"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,0,0,12"/>
                        <TextBlock x:Name="InfoTPM"
                                   Grid.Row="7" Grid.Column="1"
                                   Text="N/A"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="11" Margin="0,0,0,12"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Refresh button -->
                    <Button x:Name="BtnRefreshInfo"
                            Content="Refresh"
                            Style="{StaticResource ActionButton}"
                            Margin="0,8,0,0"/>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{StaticResource BgBorder}"
                            Margin="0,16"/>

                    <!-- Action Log -->
                    <TextBlock Text="ACTION LOG"
                               Style="{StaticResource SectionLabel}"/>

                    <Border Background="{StaticResource BgPrimary}"
                            CornerRadius="6"
                            Padding="8"
                            Height="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtActionLog"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap"
                                       Text="Ready."/>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- STATUS BAR                                       -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BgBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="TxtStatusBar"
                           Text="Ready"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TxtClock"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

    </Grid>
</Window>